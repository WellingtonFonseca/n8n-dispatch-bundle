{#
  Body of the read-only details modal of an HSM template, opened from its name on the list: the same information as the
  edit page (language, name, description, provider, router, template, type, carousel cards, text, availability, variables, campaigns).
#}
<div class="n8ndispatch-details">
    <ul class="nav nav-tabs nav-tabs-contained">
        <li class="active"><a href="#hsm-details-template" role="tab" data-toggle="tab">{{ 'mautic.n8ndispatch.hsmtemplate.tab.template.label'|trans }}</a></li>
        <li><a href="#hsm-details-campaigns" role="tab" data-toggle="tab">{{ 'mautic.n8ndispatch.hsmtemplate.tab.campaigns.label'|trans }}</a></li>
    </ul>
    <div class="tab-content pa-md">
    <div class="tab-pane fade in active bdr-w-0" id="hsm-details-template">
    <p class="n8ndispatch-template-state" title="{{ 'mautic.core.form.available'|trans }}">
        <span class="n8ndispatch-badge n8ndispatch-badge--{{ entity.isPublished ? 'active' : 'inactive' }}">
            {{ (entity.isPublished ? 'mautic.n8ndispatch.template.details.active' : 'mautic.n8ndispatch.template.details.inactive')|trans }}
        </span>
    </p>
    {# The fields as a table, like the contact page: a bold label in a 20% column, the value beside it. #}
    <div class="panel shd-none mb-0">
        <table class="table table-hover mb-0">
            <tbody>
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.core.language'|trans }}</span></td>
                <td>{{ entity.language }}</td>
            </tr>
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.core.name'|trans }}</span></td>
                <td>{{ entity.name }}</td>
            </tr>
            {% if entity.description %}
                <tr>
                    <td width="20%"><span class="fw-b textTitle">{{ 'mautic.core.description'|trans }}</span></td>
                    <td>{{ entity.description|purify }}</td>
                </tr>
            {% endif %}
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.hsmtemplate.provider.label'|trans }}</span></td>
                <td>{{ n8ndispatch_hsm_provider_label(entity) }}</td>
            </tr>
            {# The router for n8n, the name of the picked number for the DialogHSM (same text as the list). #}
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.campaign.event.hsm.router'|trans }}</span></td>
                <td>{{ n8ndispatch_hsm_router_label(entity) }}</td>
            </tr>
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.campaign.event.hsm.template'|trans }}</span></td>
                <td>{{ entity.hsmTemplate }}</td>
            </tr>
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.campaign.event.hsm.type'|trans }}</span></td>
                <td>{{ ('mautic.n8ndispatch.hsmtemplate.type.' ~ entity.type)|trans }}</td>
            </tr>
            {% if entity.type == 'image' %}
                <tr>
                    <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.hsmtemplate.image.label'|trans }}</span></td>
                    <td><a href="{{ entity.cards[0] }}" target="_blank" rel="noopener noreferrer">{{ entity.cards[0] }}</a></td>
                </tr>
            {% elseif entity.type == 'carousel' %}
                <tr>
                    <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.hsmtemplate.cards.label'|trans }}</span></td>
                    <td>
                        <ul class="list-unstyled mb-0">
                            {% for url in entity.cards|filter(u => u) %}
                                <li>{{ 'mautic.n8ndispatch.hsmtemplate.cards.card'|trans({'%n%': loop.index}) }}: <a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ url }}</a></li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
            {% endif %}
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.campaign.event.hsm.text'|trans }}</span></td>
                <td><pre class="n8ndispatch-timeline-json n8ndispatch-callback-message mb-0">{{ entity.text }}</pre></td>
            </tr>
            </tbody>
        </table>
    </div>
    {% include '@N8nDispatch/Template/_variables.html.twig' %}
    </div>
    <div class="tab-pane fade bdr-w-0" id="hsm-details-campaigns">
        {% include '@N8nDispatch/Template/_campaigns.html.twig' with {'translationBase': 'mautic.n8ndispatch.hsmtemplate'} %}
    </div>
    </div>
    {% include '@N8nDispatch/Template/_modal_buttons.html.twig' with {'editUrl': canEdit ? path('mautic_n8ndispatch.hsmtemplate_action', {'objectAction': 'edit', 'objectId': entity.id}) : null} %}
</div>
