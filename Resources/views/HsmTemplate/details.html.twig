{#
  Body of the read-only details modal of an HSM template, opened from its name on the list: the same information as the
  edit page (language, name, description, provider, router, template, type, carousel cards, text, availability, variables, campaigns).
#}
{% set dialogUrl = n8ndispatch_dialoghsm_templates_url(entity) %}
<div class="n8ndispatch-details n8ndispatch-hsm-details">
    {# Header like the patches details modals: the template name as title and, below it, the same status badge of the list's Status column. #}
    <div class="n8ndispatch-modal-head">
        <h1 class="page-header-title n8ndispatch-modal-name">{{ entity.name }}</h1>
        {% set statusText = (entity.isPublished ? 'mautic.core.form.active' : 'mautic.core.form.inactive')|trans %}
        <span class="n8ndispatch-badge n8ndispatch-template-status n8ndispatch-badge--{{ entity.isPublished ? 'production' : 'failed' }}"
              title="{{ statusText }}" aria-label="{{ statusText }}"><i class="{{ entity.isPublished ? 'ri-play-fill' : 'ri-stop-fill' }}" aria-hidden="true"></i><span class="n8ndispatch-template-status__text">{{ statusText }}</span></span>
    </div>
    <ul class="nav nav-tabs nav-tabs-contained">
        <li class="active"><a href="#hsm-details-template" role="tab" data-toggle="tab">{{ 'mautic.n8ndispatch.hsmtemplate.tab.template.label'|trans }}</a></li>
        <li><a href="#hsm-details-campaigns" role="tab" data-toggle="tab">{{ 'mautic.n8ndispatch.hsmtemplate.tab.campaigns.label'|trans }}</a></li>
        <li><a href="#hsm-details-history" role="tab" data-toggle="tab">{{ 'mautic.n8ndispatch.audit.tab'|trans }}</a></li>
        {# DialogHSM only, as the edit page: the 360Dialog's JSON of the template, filled by Mautic.n8nDispatchHsmDetails (campaign-hsm-dispatch.js) once the list answers. #}
        {% if dialogUrl %}
            <li id="hsm-json-tab" style="display: none;"><a href="#hsm-json-container" role="tab" data-toggle="tab">{{ 'mautic.n8ndispatch.hsmtemplate.dialog.json'|trans }}</a></li>
        {% endif %}
    </ul>
    <div class="tab-content pa-md">
    <div class="tab-pane fade in active bdr-w-0" id="hsm-details-template">
    <div class="n8ndispatch-hsm-split">
    <div class="n8ndispatch-hsm-split__main">
    {# The fields as a table, like the contact page: a bold label in a 20% column, the value beside it. #}
    <div class="panel shd-none mb-0">
        <table class="table table-hover mb-0">
            <tbody>
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.core.language'|trans }}</span></td>
                <td>{{ entity.language }}</td>
            </tr>
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.core.name'|trans }}</span></td>
                <td>{{ entity.name }}</td>
            </tr>
            {% if entity.description %}
                <tr>
                    <td width="20%"><span class="fw-b textTitle">{{ 'mautic.core.description'|trans }}</span></td>
                    <td>{{ entity.description|purify }}</td>
                </tr>
            {% endif %}
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.hsmtemplate.provider.label'|trans }}</span></td>
                <td>{{ n8ndispatch_hsm_provider_label(entity) }}</td>
            </tr>
            {# The router for n8n, the name of the picked number for the DialogHSM (same text as the list). #}
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.campaign.event.hsm.router'|trans }}</span></td>
                <td>{{ n8ndispatch_hsm_router_label(entity) }}</td>
            </tr>
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.campaign.event.hsm.template'|trans }}</span></td>
                <td>{{ entity.hsmTemplate }}</td>
            </tr>
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.campaign.event.hsm.type'|trans }}</span></td>
                <td>{{ ('mautic.n8ndispatch.hsmtemplate.type.' ~ entity.type)|trans }}</td>
            </tr>
            {% if entity.type in ['image', 'video', 'document'] %}
                <tr>
                    <td width="20%"><span class="fw-b textTitle">{{ ('mautic.n8ndispatch.hsmtemplate.' ~ entity.type ~ '.label')|trans }}</span></td>
                    <td><a href="{{ entity.cards[0] }}" target="_blank" rel="noopener noreferrer">{{ entity.cards[0] }}</a></td>
                </tr>
            {% elseif entity.type == 'carousel' %}
                <tr>
                    <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.hsmtemplate.cards.label'|trans }}</span></td>
                    <td>
                        <ul class="list-unstyled mb-0">
                            {% for url in entity.cards|filter(u => u) %}
                                <li>{{ 'mautic.n8ndispatch.hsmtemplate.cards.card'|trans({'%n%': loop.index}) }}: <a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ url }}</a></li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
            {% endif %}
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.campaign.event.hsm.text'|trans }}</span></td>
                <td><pre class="n8ndispatch-timeline-json n8ndispatch-callback-message mb-0">{{ entity.text }}</pre></td>
            </tr>
            </tbody>
        </table>
    </div>
    {% include '@N8nDispatch/Template/_variables.html.twig' %}
    </div>
    {# The DialogHSM's preview on the right of a vertical divider, like the edit page (filled by the script; the component is the DialogHSM's, absent without the plugin). #}
    {% if dialogUrl %}
        {% include '@DialogHSM/FormTheme/_wa_preview.html.twig' ignore missing %}
        <div class="n8ndispatch-hsm-split__side" id="n8ndispatch-hsm-preview" style="display: none;">
            <div id="n8ndispatch-hsm-preview-body" style="width: 100%; max-width: 360px; margin: 0 auto;"></div>
        </div>
    {% endif %}
    </div>
    </div>
    <div class="tab-pane fade bdr-w-0" id="hsm-details-campaigns">
        {% include '@N8nDispatch/Template/_campaigns.html.twig' with {'translationBase': 'mautic.n8ndispatch.hsmtemplate'} %}
    </div>
    {% include '@N8nDispatch/Template/_audit_pane.html.twig' with {'id': 'hsm-details-history', 'rows': n8ndispatch_template_audit('hsm_template', entity.id)} only %}
    {% if dialogUrl %}
        <div class="tab-pane fade bdr-w-0" id="hsm-json-container">
            <p class="help-block">{{ 'mautic.n8ndispatch.hsmtemplate.dialog.json.help'|trans }}</p>
            <div class="mb-sm">
                <button type="button" class="btn btn-tertiary btn-sm btn-nospin" id="n8ndispatch-hsm-json-copy" data-copied="{{ 'mautic.n8ndispatch.hsmtemplate.dialog.json.copied'|trans|e('html_attr') }}">
                    <i class="ri-file-copy-line"></i> <span>{{ 'mautic.n8ndispatch.hsmtemplate.dialog.json.copy'|trans }}</span>
                </button>
            </div>
            <pre id="n8ndispatch-hsm-json" style="max-height: 60vh; overflow: auto; white-space: pre; user-select: all;"></pre>
        </div>
    {% endif %}
    </div>
    {% if dialogUrl %}
        <div class="hidden" id="n8ndispatch-hsm-details-config"
             data-templates-url="{{ dialogUrl }}{{ entity.whatsappNumberId }}"
             data-template-name="{{ entity.hsmTemplate|e('html_attr') }}"
             data-template-language="{{ entity.templateLanguage|e('html_attr') }}"
             data-cards="{{ entity.cards|json_encode|e('html_attr') }}"
             data-variables="{{ (entity.variablesJson ?: '{}')|e('html_attr') }}"
             data-preview-title="{{ 'mautic.n8ndispatch.hsmtemplate.dialog.preview.title'|trans|e('html_attr') }}"></div>
        <script>if (window.Mautic && Mautic.n8nDispatchHsmDetails) { Mautic.n8nDispatchHsmDetails(); }</script>
    {% endif %}
    {% include '@N8nDispatch/Template/_modal_buttons.html.twig' with {'editUrl': canEdit ? path('mautic_n8ndispatch.hsmtemplate_action', {'objectAction': 'edit', 'objectId': entity.id}) : null} %}
</div>
