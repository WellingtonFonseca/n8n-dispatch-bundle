{#
  Own list view instead of core's Standard list.html.twig: that one probes
  attribute(item, 'getCategory'), which throws for entities with no
  category (FormEntity's __call), as soon as the list has a row.
  Modeled on core's PointBundle Group/list.html.twig (same as
  Resources/views/SmsTemplate/list.html.twig).
#}
{% set isIndex = 'index' == tmpl ? true : false %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}

{% block mauticContent %}n8ndispatch.hsmtemplate{% endblock %}

{% block headerTitle %}{{ 'mautic.n8ndispatch.hsmtemplate.header.index'|trans }}{% endblock %}

{% block content %}
    {% if isIndex %}
    <div id="page-list-wrapper" class="panel panel-default">
        {{- include('@MauticCore/Helper/list_toolbar.html.twig', {
            'searchValue': searchValue,
            'action': currentRoute,
            'list_actions': include('@MauticCore/Helper/toolbar_page_actions.html.twig', {
                'templateButtons': {
                    'new': permissions['sms:smses:create'],
                },
                'routeBase': 'n8ndispatch.hsmtemplate',
                'langVar': 'n8ndispatch.hsmtemplate',
            })
        }) -}}
        <div class="page-list">
            {{ block('listContent') }}
        </div>
    </div>
    {% else %}
        {{ block('listContent') }}
    {% endif %}
{% endblock %}

{% block listContent %}
    {% if items is defined and items is not empty %}
        <div class="table-responsive">
            <table class="table table-hover" id="hsmTemplateTable">
                <thead>
                <tr>
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'checkall': 'true',
                        'target': '#hsmTemplateTable',
                        'langVar': 'n8ndispatch.hsmtemplate',
                        'routeBase': 'n8ndispatch.hsmtemplate',
                        'templateButtons': {
                            'delete': permissions['sms:smses:deleteown'] or permissions['sms:smses:deleteother'],
                        },
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'n8ndispatch.hsmtemplate',
                        'orderBy': 'ht.name',
                        'text': 'mautic.core.name',
                        'class': 'col-hsmtemplate-name',
                        'default': true,
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'n8ndispatch.hsmtemplate',
                        'orderBy': 'ht.router',
                        'text': 'mautic.n8ndispatch.campaign.event.hsm.router',
                        'class': 'col-hsmtemplate-router',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'n8ndispatch.hsmtemplate',
                        'orderBy': 'ht.hsmTemplate',
                        'text': 'mautic.n8ndispatch.campaign.event.hsm.template',
                        'class': 'col-hsmtemplate-template',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'sessionVar': 'n8ndispatch.hsmtemplate',
                        'orderBy': 'ht.id',
                        'text': 'mautic.core.id',
                        'class': 'visible-md visible-lg col-hsmtemplate-id',
                    }) }}
                </tr>
                </thead>
                <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            {{- include('@MauticCore/Helper/list_actions.html.twig', {
                                'item': item,
                                'templateButtons': {
                                    'edit': securityHasEntityAccess(permissions['sms:smses:editown'], permissions['sms:smses:editother'], item.getCreatedBy()),
                                    'clone': permissions['sms:smses:create'],
                                    'delete': securityHasEntityAccess(permissions['sms:smses:deleteown'], permissions['sms:smses:deleteother'], item.getCreatedBy()),
                                },
                                'customButtons': securityHasEntityAccess(permissions['sms:smses:editown'], permissions['sms:smses:editother'], item.getCreatedBy()) ? [{
                                    'attr': {
                                        'data-toggle': 'n8n-status',
                                        'data-n8n-status-action': item.isPublished() ? 'deactivate' : 'activate',
                                        'data-text-activate': 'mautic.n8ndispatch.template.status.activate'|trans,
                                        'data-text-deactivate': 'mautic.n8ndispatch.template.status.deactivate'|trans,
                                        'href': 'javascript:void(0);',
                                    },
                                    'btnText': (item.isPublished() ? 'mautic.n8ndispatch.template.status.deactivate' : 'mautic.n8ndispatch.template.status.activate')|trans,
                                    'iconClass': item.isPublished() ? 'ri-close-circle-line' : 'ri-checkbox-circle-line',
                                    'priority': 300,
                                }] : [],
                                'routeBase': 'n8ndispatch.hsmtemplate',
                                'langVar': 'n8ndispatch.hsmtemplate',
                                'translationBase': 'mautic.n8ndispatch.hsmtemplate',
                            }) -}}
                        </td>
                        <td>
                            <div>
                                <span class="n8ndispatch-badge n8ndispatch-template-status n8ndispatch-badge--{{ item.isPublished() ? 'production' : 'failed' }}"
                                      data-state="{{ item.isPublished() ? 'published' : 'unpublished' }}"
                                      data-text-published="{{ 'mautic.core.form.active'|trans }}" data-text-unpublished="{{ 'mautic.core.form.inactive'|trans }}">{{ (item.isPublished() ? 'mautic.core.form.active' : 'mautic.core.form.inactive')|trans }}</span>
                                {{- include('@MauticCore/Helper/publishstatus_icon.html.twig', {
                                    'item': item,
                                    'model': 'n8ndispatch.hsmtemplate',
                                }) -}}
                                <a href="{{ path('mautic_n8ndispatch.hsmtemplate_action', {'objectAction': 'details', 'objectId': item.getId()}) }}" data-toggle="ajaxmodal" data-target="#MauticSharedModal" data-header="{{ 'mautic.n8ndispatch.hsmtemplate.details.title'|trans }}">
                                    {{ item.getName() }}
                                </a>
                            </div>
                            {% if item.getDescription() %}
                                <div class="text-muted mt-4"><small>{{ item.getDescription()|purify }}</small></div>
                            {% endif %}
                        </td>
                        <td>{{ item.getRouter() }}</td>
                        <td>{{ item.getHsmTemplate() }}</td>
                        <td class="visible-md visible-lg">{{ item.getId() }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="panel-footer">
            {{- include('@MauticCore/Helper/pagination.html.twig', {
                'totalItems': totalItems,
                'page': page,
                'limit': limit,
                'baseUrl': path('mautic_n8ndispatch.hsmtemplate_index'),
                'sessionVar': 'n8ndispatch.hsmtemplate',
            }) -}}
        </div>
    {% else %}
        {{ include('@MauticCore/Helper/noresults.html.twig') }}
    {% endif %}
{% endblock %}
