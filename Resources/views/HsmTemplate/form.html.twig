{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}n8ndispatch.hsmtemplate{% endblock %}

{% block headerTitle %}
    {% if entity.id %}
        {{ 'mautic.n8ndispatch.hsmtemplate.menu.edit'|trans({'%name%': entity.name}) }}
    {% else %}
        {{ 'mautic.n8ndispatch.hsmtemplate.menu.new'|trans }}
    {% endif %}
{% endblock %}

{#
  Options dropdown with Clone/Delete, both inside the dropdown, pushed to
  the far right past the Save/Apply/Cancel buttons. Identical to
  Resources/views/SmsTemplate/form.html.twig's own 'actions' block — see
  that file's comment for the full reasoning (TYPE_DROPDOWN vs.
  page_actions.html.twig's TYPE_BUTTON_DROPDOWN, and the 'order'/'ml-xs'
  positioning).
#}
{% block actions %}
    {% if entity.id %}
        {{ buttonReset(
            constant('Mautic\\CoreBundle\\Twig\\Helper\\ButtonHelper::LOCATION_PAGE_ACTIONS'),
            constant('Mautic\\CoreBundle\\Twig\\Helper\\ButtonHelper::TYPE_DROPDOWN'),
            entity
        ) }}

        {% if permissions['sms:smses:create'] %}
            {{ buttonAdd({
                attr: {
                    'href'        : path('mautic_n8ndispatch.hsmtemplate_action', {'objectAction': 'clone', 'objectId': entity.getId()}),
                    'data-toggle' : 'ajax',
                },
                iconClass : 'ri-file-copy-line',
                btnText   : 'mautic.core.form.clone'|trans,
                priority  : 200,
            }) }}
        {% endif %}

        {% if securityHasEntityAccess(permissions['sms:smses:deleteown'], permissions['sms:smses:deleteother'], entity.getCreatedBy()) %}
            {{ buttonAdd({
                confirm: {
                    btnClass      : false,
                    message       : 'mautic.n8ndispatch.hsmtemplate.form.confirmdelete'|trans({'%name%': entity.getName() ~ ' (' ~ entity.getId() ~ ')'}),
                    confirmAction : path('mautic_n8ndispatch.hsmtemplate_action', {'objectAction': 'delete', 'objectId': entity.getId()}),
                    template      : 'delete',
                },
                priority: -1,
            }) }}
        {% endif %}

        <div class="std-toolbar n8ndispatch-template-actions ml-xs">
            {% include '@MauticCore/Helper/button.html.twig' with {
                buttons: [
                    {
                        variant    : 'primary',
                        icon_only  : true,
                        icon       : 'ri-arrow-down-s-line',
                        label      : 'mautic.core.options',
                        attributes : {
                            'class'         : 'dropdown-toggle',
                            'data-toggle'   : 'dropdown',
                            'aria-expanded' : 'false',
                        },
                    },
                ],
            } %}
            <ul class="dropdown-menu dropdown-menu-right" role="menu">
                {{ buttonsRender()|raw }}
            </ul>
        </div>
    {% endif %}
{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <div class="box-layout">
        <div class="col-md-9 height-auto bdr-r">
            <div class="pa-md">
                {{ form_row(form.name) }}
                {{ form_row(form.description) }}
                <div class="row">
                    <div class="col-xs-4">
                        {{ form_row(form.router) }}
                    </div>
                    <div class="col-xs-4">
                        {{ form_row(form.hsmId) }}
                    </div>
                    <div class="col-xs-4">
                        {{ form_row(form.type) }}
                    </div>
                </div>
                {# The .row wrapper matters: campaign-hsm-dispatch.js
                   inserts the variable-source rows right after the
                   textarea's closest .row (see getContainer() in
                   campaign-email-dispatch.js). #}
                <div class="row">
                    <div class="col-xs-12">
                        {{ form_row(form.text) }}
                        <p class="help-block">{{ 'mautic.n8ndispatch.hsmtemplate.text.help'|trans }}</p>
                    </div>
                </div>
                {% if entity.id %}
                    {# Same status pill as the contact History card
                       (SubscribedEvents/Timeline/_email_send.html.twig). #}
                    {% set statusIcons = {
                        'test':       'ri-bug-line',
                        'production': 'ri-play-fill',
                        'paused':     'ri-pause-fill',
                    } %}
                    <div class="mt-lg">
                        <h4 class="mb-sm">{{ 'mautic.n8ndispatch.hsmtemplate.usages.header'|trans }}</h4>
                        {% if campaignUsages is defined and campaignUsages is not empty %}
                            <table class="table table-condensed">
                                <thead>
                                <tr>
                                    <th>{{ 'mautic.n8ndispatch.hsmtemplate.usages.campaign'|trans }}</th>
                                    <th>{{ 'mautic.n8ndispatch.hsmtemplate.usages.step'|trans }}</th>
                                    <th>{{ 'mautic.n8ndispatch.campaign.event.status'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for usage in campaignUsages %}
                                    <tr>
                                        <td>
                                            <a href="{{ path('mautic_campaign_action', {'objectAction': 'view', 'objectId': usage.campaignId}) }}" data-toggle="ajax">{{ usage.campaignName }}</a>
                                            {% if not usage.campaignPublished %}
                                                <span class="label label-default">{{ 'mautic.n8ndispatch.hsmtemplate.usages.unpublished'|trans }}</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ usage.eventName }}</td>
                                        <td>
                                            {% set status = statusIcons[usage.status] is defined ? usage.status : 'test' %}
                                            <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ status }}">
                                                <i class="{{ statusIcons[status] }}"></i>
                                                {{ ('mautic.n8ndispatch.campaign.event.status.' ~ status)|trans }}
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <p class="text-muted">{{ 'mautic.n8ndispatch.hsmtemplate.usages.none'|trans }}</p>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="col-md-3 height-auto">
            <div class="pr-lg pl-lg pt-md pb-md">
                {{ form_row(form.isPublished) }}
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
