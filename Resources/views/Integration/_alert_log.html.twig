{#
  The latest alerts Mautic raised and what became of them (sent to the webhook, or not sent and why). Assets/js/plugin-alerts-tab.js
  moves the block under the fields of the Alertas tab. Without the script it stays under the fields of the first tab.
  Needs: alertLog, a list of {created_at (UTC), alert, outcome, reason, detail, subject}.
#}

<div class="n8ndispatch-alert-log-block">
    <h4 class="mt-lg mb-sm">{{ 'mautic.n8ndispatch.settings.alerts.log.title'|trans }}</h4>
    <p class="text-muted">{{ 'mautic.n8ndispatch.settings.alerts.log.help'|trans }}</p>
    {% if alertLog %}
        <div class="n8ndispatch-alert-log">
            <table class="table table-hover table-striped table-bordered">
                <thead>
                    <tr>
                        <th>{{ 'mautic.n8ndispatch.settings.alerts.log.status'|trans }}</th>
                        <th>{{ 'mautic.n8ndispatch.settings.alerts.log.detail'|trans }}</th>
                        <th>{{ 'mautic.n8ndispatch.settings.alerts.log.date'|trans }}</th>
                        <th>{{ 'mautic.n8ndispatch.settings.alerts.log.alert'|trans }}</th>
                        <th>{{ 'mautic.n8ndispatch.settings.alerts.log.subject'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in alertLog %}
                        <tr class="n8ndispatch-alert-log__row" data-outcome="{{ row.outcome }}">
                            <td>
                                {% if row.outcome == 'sent' %}
                                    <span class="label label-success">{{ 'mautic.n8ndispatch.settings.alerts.log.sent'|trans }}</span>
                                {% else %}
                                    <span class="label label-danger">{{ 'mautic.n8ndispatch.settings.alerts.log.not_sent'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if row.outcome != 'sent' %}
                                    {{ ('mautic.n8ndispatch.settings.alerts.log.reason.' ~ row.reason)|trans }}{% if row.detail %}: {{ row.detail }}{% endif %}
                                {% endif %}
                            </td>
                            <td>{{ dateToFullConcat(row.created_at, 'UTC') }}</td>
                            <td>alert.{{ row.alert }}</td>
                            <td>{{ row.subject }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="n8ndispatch-alert-log__empty">{{ 'mautic.n8ndispatch.settings.alerts.log.empty'|trans }}</p>
    {% endif %}
</div>
