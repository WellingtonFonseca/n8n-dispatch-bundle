{#
  Body of the resend modal opened from the Dispatches table: the variables of the template with the value the first
  dispatch sent, and the value of today in an input the user can correct. The buttons post it
  (Assets/js/dispatch-resend.js). A row with no value (empty / not mapped) is marked, so the user sees BEFORE the
  resend what would go out empty.
#}
<div class="n8ndispatch-resend" data-resend-log="{{ dispatch.id }}">
    <p>
        <strong>{{ 'mautic.n8ndispatch.dispatch.details.campaign'|trans }}:</strong> {{ dispatch.campaignName }}<br/>
        <strong>{{ 'mautic.n8ndispatch.dispatch.details.template'|trans }}:</strong> {{ dispatch.templateName }}<br/>
        <strong>{{ 'mautic.n8ndispatch.dispatch.details.contact'|trans }}:</strong> {{ dispatch.contactEmail ?: '-' }}
    </p>

    {% if rows|length > 0 %}
    <p class="text-muted">{{ 'mautic.n8ndispatch.dispatch.resend.form.help'|trans }}</p>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>{{ 'mautic.n8ndispatch.dispatch.resend.form.variable'|trans }}</th>
                    <th>{{ 'mautic.n8ndispatch.dispatch.resend.form.first'|trans }}</th>
                    <th>{{ 'mautic.n8ndispatch.dispatch.resend.form.value'|trans }}</th>
                </tr>
            </thead>
            <tbody>
            {% for row in rows %}
                <tr data-resend-state="{{ row.state }}">
                    <td><code>{{ row.name }}</code></td>
                    <td>{{ row.first != '' ? row.first : '-' }}</td>
                    <td>
                        <input type="text" class="form-control" data-resend-variable="{{ row.name }}" value="{{ row.current }}" />
                        {% if row.state == 'unmapped' %}
                            <span class="text-danger">{{ 'mautic.n8ndispatch.dispatch.resend.form.unmapped'|trans }}</span>
                        {% elseif row.state == 'empty' %}
                            <span class="text-warning">{{ 'mautic.n8ndispatch.dispatch.resend.form.empty'|trans }}</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    <p class="text-muted">{{ 'mautic.n8ndispatch.dispatch.resend.confirm'|trans }}</p>

    <div class="text-right">
        <button type="button" class="btn btn-ghost" data-dismiss="modal" data-resend-cancel>{{ 'mautic.n8ndispatch.dispatch.resend.cancel_btn'|trans }}</button>
        <button type="button" class="btn btn-primary" data-resend-confirm onclick="Mautic.n8ndispatchSubmitResend(this);">{{ 'mautic.n8ndispatch.dispatch.resend.confirm_btn'|trans }}</button>
    </div>
</div>
