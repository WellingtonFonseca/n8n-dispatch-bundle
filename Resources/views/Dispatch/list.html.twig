{#
  Dispatches table. Same layout as Resources/views/HsmTemplate/list.html.twig,
  minus the row selection: the first column is only the options menu, so a
  dispatch can only be resent one at a time, never by a stray multi-select.
  Then the dispatch date and time, the callback badge, the step's status, the
  campaign, the template and the contact (the last three are links that open in a new tab).
  The rows are arrays, not entities.
#}
{% set isIndex = 'index' == tmpl ? true : false %}
{% set tmpl = 'list' %}
{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}

{% block mauticContent %}n8ndispatch.dispatch{% endblock %}

{% block headerTitle %}{{ 'mautic.n8ndispatch.dispatch.header.index'|trans }}{% endblock %}

{% block content %}
    {% if isIndex %}
    <div id="page-list-wrapper" class="panel panel-default">
        {# Filter bar: a plain GET form (the filters live in the query string, which the pagination links and the resend reload keep). Same field pattern as the template forms: a label with the field under it. #}
        <form method="get" action="{{ path('mautic_n8ndispatch.dispatch_index') }}" class="n8ndispatch-filters" style="padding: 15px 15px 0;">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label" for="dispatch-filter-campaign">{{ 'mautic.n8ndispatch.dispatch.filter.campaign'|trans }}</label>
                        <select id="dispatch-filter-campaign" name="campaign" class="form-control">
                            <option value="">{{ 'mautic.n8ndispatch.dispatch.filter.all'|trans }}</option>
                            {% for id, name in options.campaigns %}
                                <option value="{{ id }}"{{ filters.campaign is defined and filters.campaign == id ? ' selected' : '' }}>{{ name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label" for="dispatch-filter-template">{{ 'mautic.n8ndispatch.dispatch.filter.template'|trans }}</label>
                        <select id="dispatch-filter-template" name="template" class="form-control">
                            <option value="">{{ 'mautic.n8ndispatch.dispatch.filter.all'|trans }}</option>
                            {% for channel, names in options.templates %}
                                <optgroup label="{{ ('mautic.n8ndispatch.dispatch.filter.channel.' ~ channel)|trans }}">
                                    {% for key, name in names %}
                                        <option value="{{ key }}"{{ filters.template is defined and filters.template == key ? ' selected' : '' }}>{{ name }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="control-label" for="dispatch-filter-from">{{ 'mautic.n8ndispatch.dispatch.filter.from'|trans }}</label>
                        <input type="text" id="dispatch-filter-from" name="from" value="{{ filters.from|default('') }}" class="form-control" data-toggle="date" data-format="{{ dateFormat }}" autocomplete="off">
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="control-label" for="dispatch-filter-to">{{ 'mautic.n8ndispatch.dispatch.filter.to'|trans }}</label>
                        <input type="text" id="dispatch-filter-to" name="to" value="{{ filters.to|default('') }}" class="form-control" data-toggle="date" data-format="{{ dateFormat }}" autocomplete="off">
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="control-label" for="dispatch-filter-status">{{ 'mautic.n8ndispatch.dispatch.filter.status'|trans }}</label>
                        <select id="dispatch-filter-status" name="status" class="form-control">
                            <option value="">{{ 'mautic.n8ndispatch.dispatch.filter.all'|trans }}</option>
                            {% for status in statuses %}
                                <option value="{{ status }}"{{ filters.status is defined and filters.status == status ? ' selected' : '' }}>{{ ('mautic.n8ndispatch.dispatch.filter.status.' ~ status)|trans }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary"><i class="ri-filter-line"></i> {{ 'mautic.n8ndispatch.dispatch.filter.apply'|trans }}</button>
                {% if hasFilters %}
                    <a href="{{ path('mautic_n8ndispatch.dispatch_index') }}" class="btn btn-ghost">{{ 'mautic.n8ndispatch.dispatch.filter.clear'|trans }}</a>
                {% endif %}
            </div>
        </form>
        {% if capped %}
            <div class="alert alert-warning" style="margin: 0 15px 10px;">{{ 'mautic.n8ndispatch.dispatch.filter.capped'|trans({'%limit%': scanLimit}) }}</div>
        {% endif %}
        <div class="page-list">
            {{ block('listContent') }}
        </div>
    </div>
    {% else %}
        {{ block('listContent') }}
    {% endif %}
{% endblock %}

{% block listContent %}
    {% if items is defined and items is not empty %}
        <div class="table-responsive">
            <table class="table table-hover" id="dispatchTable">
                <thead>
                <tr>
                    <th class="col-actions"></th>
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.n8ndispatch.dispatch.column.date',
                        'class': 'col-dispatch-date',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.n8ndispatch.dispatch.column.callback',
                        'class': 'col-dispatch-callback',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.n8ndispatch.dispatch.column.step_status',
                        'class': 'col-dispatch-step-status',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.n8ndispatch.dispatch.column.campaign',
                        'class': 'col-dispatch-campaign',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.n8ndispatch.dispatch.column.template',
                        'class': 'col-dispatch-template',
                    }) }}
                    {{ include('@MauticCore/Helper/tableheader.html.twig', {
                        'text': 'mautic.n8ndispatch.dispatch.column.name',
                        'class': 'col-dispatch-name',
                    }) }}
                </tr>
                </thead>
                <tbody>
                {% for item in items %}
                    <tr>
                        {#
                          Same callbacks the badge column shows (HSM: Meta's only). Resend is
                          offered when one of them ended in error or the call itself was refused; every row has its options menu, with the details modal. The options menu is
                          core's list_actions markup written out here, because that helper
                          only knows edit/clone/delete.
                        #}
                        {% set callbacks = n8ndispatch_status(item.metadata)|filter(c => c.refType != 'logSendHsmId') %}
                        {% set canResend = item.failed or callbacks|filter(c => c.outcome == 'error')|length > 0 %}
                        <td>
                            <div class="input-group input-group-sm">
                                <div class="ml-xs">
                                    {% include '@MauticCore/Helper/button.html.twig' with {
                                        buttons: [
                                            {
                                                label: 'mautic.core.options',
                                                size: 'sm',
                                                variant: 'ghost',
                                                icon: 'ri-more-2-line',
                                                icon_only: true,
                                                spin: false,
                                                attributes: {
                                                    'data-toggle': 'dropdown',
                                                    'type': 'button'
                                                }
                                            }
                                        ]
                                    } %}
                                    <ul class="pull-left page-list-actions dropdown-menu" role="menu">
                                        <li>
                                            <a href="{{ path('mautic_n8ndispatch.dispatch_details', {'id': item.id}) }}" data-toggle="ajaxmodal" data-target="#MauticSharedModal" data-header="{{ 'mautic.n8ndispatch.dispatch.details.title'|trans }}">
                                                <i class="ri-information-line"></i> {{ 'mautic.n8ndispatch.dispatch.action.details'|trans }}
                                            </a>
                                        </li>
                                        {% if canResend %}
                                        <li>
                                            <a href="#" data-dispatch-resend="{{ item.id }}"
                                               onclick="Mautic.showConfirmation(this); return false;"
                                               data-message="{{ 'mautic.n8ndispatch.dispatch.resend.confirm'|trans }}"
                                               data-confirm-text="{{ 'mautic.n8ndispatch.dispatch.resend.confirm_btn'|trans }}"
                                               data-cancel-text="{{ 'mautic.n8ndispatch.dispatch.resend.cancel_btn'|trans }}"
                                               data-confirm-callback="n8ndispatchConfirmResend"
                                               data-confirm-btn-class="btn btn-primary">
                                                <i class="ri-send-plane-line"></i> {{ 'mautic.n8ndispatch.dispatch.action.resend'|trans }}
                                            </a>
                                        </li>
                                        {% endif %}
                                    </ul>
                                </div>
                            </div>
                        </td>
                        <td>{{ n8ndispatch_date(item.dispatchedAt) }}</td>
                        <td>
                            {#
                              Same badges as the Timeline card (css loaded on every page by
                              AssetInjectionSubscriber): the current outcome of the tracked id.
                              HSM has two, Mirror and Meta, and only Meta's is shown. No ids
                              (test, paused or failed dispatch) shows a dash.
                            #}
                            {% for callback in callbacks %}
                                {% set badgeClass = {'success': 'success', 'error': 'failed', 'pending': 'pending'}[callback.outcome] %}
                                {% set badgeIcon  = {'success': 'ri-check-line', 'error': 'ri-close-line', 'pending': 'ri-time-line'}[callback.outcome] %}
                                <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ badgeClass }}"{% if callback.message %} title="{{ callback.message }}"{% endif %}>
                                    <i class="{{ badgeIcon }}"></i>
                                    {{ ('mautic.n8ndispatch.timeline.callback.outcome.' ~ callback.outcome)|trans }}
                                </span>
                            {% else %}
                                {# No callback: either nothing to ask about, or the call itself was refused. #}
                                {% if item.failed %}
                                    <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--failed"><i class="ri-close-line"></i> {{ 'mautic.n8ndispatch.timeline.status.failed'|trans }}</span>
                                {% else %}
                                    -
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            {# The mode the campaign step is in now (the same badge as the campaign builder and the card): only 'production' can be resent. #}
                            {% set stepIcon = {'test': 'ri-bug-line', 'production': 'ri-play-fill', 'paused': 'ri-pause-fill'}[item.stepStatus] %}
                            <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ item.stepStatus }}">
                                <i class="{{ stepIcon }}"></i>
                                {{ ('mautic.n8ndispatch.campaign.event.status.' ~ item.stepStatus)|trans }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('mautic_campaign_action', {'objectAction': 'view', 'objectId': item.campaignId}) }}" target="_blank" rel="noopener">{{ item.campaignName }}</a>
                        </td>
                        <td>
                            {% if item.templateRoute %}
                                <a href="{{ path(item.templateRoute.name, item.templateRoute.params) }}" target="_blank" rel="noopener">{{ item.templateName }}</a>
                            {% else %}
                                {{ item.templateName }}
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('mautic_contact_action', {'objectAction': 'view', 'objectId': item.contactId}) }}" target="_blank" rel="noopener">{{ item.contactName }}</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="panel-footer">
            {{- include('@MauticCore/Helper/pagination.html.twig', {
                'totalItems': totalItems,
                'page': page,
                'limit': limit,
                'baseUrl': path('mautic_n8ndispatch.dispatch_index'),
                'queryString': queryString,
                'sessionVar': 'n8ndispatch.dispatch',
            }) -}}
        </div>
    {% else %}
        {{ include('@MauticCore/Helper/noresults.html.twig') }}
    {% endif %}
{% endblock %}
