{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}n8ndispatch.smstemplate{% endblock %}

{% block headerTitle %}
    {% if entity.id %}
        {{ 'mautic.n8ndispatch.smstemplate.menu.edit'|trans({'%name%': entity.name}) }}
    {% else %}
        {{ 'mautic.n8ndispatch.smstemplate.menu.new'|trans }}
    {% endif %}
{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <div class="box-layout">
        <div class="col-md-9 height-auto bdr-r">
            <div class="pa-md">
                {{ form_row(form.name) }}
                {{ form_row(form.description) }}
                {# The .row wrapper matters: campaign-sms-dispatch.js inserts
                   the variable-source rows right after the textarea's
                   closest .row (see getContainer() in
                   campaign-email-dispatch.js). #}
                <div class="row">
                    <div class="col-xs-12">
                        {{ form_row(form.text) }}
                        <p class="help-block">{{ 'mautic.n8ndispatch.smstemplate.text.help'|trans }}</p>
                    </div>
                </div>
                {% if entity.id %}
                    {# Same status pill as the contact History card
                       (SubscribedEvents/Timeline/_email_send.html.twig). #}
                    {% set statusIcons = {
                        'test':       'ri-bug-line',
                        'production': 'ri-play-fill',
                        'paused':     'ri-pause-fill',
                    } %}
                    <div class="mt-lg">
                        <h4 class="mb-sm">{{ 'mautic.n8ndispatch.smstemplate.usages.header'|trans }}</h4>
                        {% if campaignUsages is defined and campaignUsages is not empty %}
                            <table class="table table-condensed">
                                <thead>
                                <tr>
                                    <th>{{ 'mautic.n8ndispatch.smstemplate.usages.campaign'|trans }}</th>
                                    <th>{{ 'mautic.n8ndispatch.smstemplate.usages.step'|trans }}</th>
                                    <th>{{ 'mautic.n8ndispatch.campaign.event.status'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for usage in campaignUsages %}
                                    <tr>
                                        <td>
                                            <a href="{{ path('mautic_campaign_action', {'objectAction': 'view', 'objectId': usage.campaignId}) }}" data-toggle="ajax">{{ usage.campaignName }}</a>
                                            {% if not usage.campaignPublished %}
                                                <span class="label label-default">{{ 'mautic.n8ndispatch.smstemplate.usages.unpublished'|trans }}</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ usage.eventName }}</td>
                                        <td>
                                            {% set status = statusIcons[usage.status] is defined ? usage.status : 'test' %}
                                            <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ status }}">
                                                <i class="{{ statusIcons[status] }}"></i>
                                                {{ ('mautic.n8ndispatch.campaign.event.status.' ~ status)|trans }}
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <p class="text-muted">{{ 'mautic.n8ndispatch.smstemplate.usages.none'|trans }}</p>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="col-md-3 height-auto">
            <div class="pr-lg pl-lg pt-md pb-md">
                {{ form_row(form.isPublished) }}
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
