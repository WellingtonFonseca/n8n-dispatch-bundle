{#
  Body of the read-only details modal of an SMS template, opened from its name on the list: the same information as the
  edit page (language, name, description, provider, text, availability, variables, campaigns using it).
#}
<div class="n8ndispatch-details">
    <ul class="nav nav-tabs nav-tabs-contained">
        <li class="active"><a href="#sms-details-template" role="tab" data-toggle="tab">{{ 'mautic.n8ndispatch.smstemplate.tab.template.label'|trans }}</a></li>
        <li><a href="#sms-details-campaigns" role="tab" data-toggle="tab">{{ 'mautic.n8ndispatch.smstemplate.tab.campaigns.label'|trans }}</a></li>
        <li><a href="#sms-details-history" role="tab" data-toggle="tab">{{ 'mautic.n8ndispatch.audit.tab'|trans }}</a></li>
    </ul>
    <div class="tab-content pa-md">
    <div class="tab-pane fade in active bdr-w-0" id="sms-details-template">
    <p class="n8ndispatch-template-state" title="{{ 'mautic.core.form.available'|trans }}">
        <span class="n8ndispatch-badge n8ndispatch-badge--{{ entity.isPublished ? 'active' : 'inactive' }}">
            {{ (entity.isPublished ? 'mautic.n8ndispatch.template.details.active' : 'mautic.n8ndispatch.template.details.inactive')|trans }}
        </span>
    </p>
    {# The fields as a table, like the contact page: a bold label in a 20% column, the value beside it. #}
    <div class="panel shd-none mb-0">
        <table class="table table-hover mb-0">
            <tbody>
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.core.language'|trans }}</span></td>
                <td>{{ entity.language }}</td>
            </tr>
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.core.name'|trans }}</span></td>
                <td>{{ entity.name }}</td>
            </tr>
            {% if entity.description %}
                <tr>
                    <td width="20%"><span class="fw-b textTitle">{{ 'mautic.core.description'|trans }}</span></td>
                    <td>{{ entity.description|purify }}</td>
                </tr>
            {% endif %}
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.smstemplate.provider.label'|trans }}</span></td>
                <td>{{ ('mautic.n8ndispatch.smstemplate.provider.' ~ entity.provider)|trans }}</td>
            </tr>
            <tr>
                <td width="20%"><span class="fw-b textTitle">{{ 'mautic.n8ndispatch.template.details.text'|trans }}</span></td>
                <td><pre class="n8ndispatch-timeline-json n8ndispatch-callback-message mb-0">{{ entity.text }}</pre></td>
            </tr>
            </tbody>
        </table>
    </div>
    {% include '@N8nDispatch/Template/_variables.html.twig' %}
    </div>
    <div class="tab-pane fade bdr-w-0" id="sms-details-campaigns">
        {% include '@N8nDispatch/Template/_campaigns.html.twig' with {'translationBase': 'mautic.n8ndispatch.smstemplate'} %}
    </div>
    {% include '@N8nDispatch/Template/_audit_pane.html.twig' with {'id': 'sms-details-history', 'rows': n8ndispatch_template_audit('sms_template', entity.id)} only %}
    </div>
    {% include '@N8nDispatch/Template/_modal_buttons.html.twig' with {'editUrl': canEdit ? path('mautic_n8ndispatch.smstemplate_action', {'objectAction': 'edit', 'objectId': entity.id}) : null} %}
</div>
