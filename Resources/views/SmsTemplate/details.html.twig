{#
  Body of the read-only details modal of an SMS template, opened from its name on the list: the same information as the
  edit page (language, name, description, text, availability, variables, campaigns using it).
#}
<div class="n8ndispatch-details">
    <ul class="nav nav-tabs nav-tabs-contained">
        <li class="active"><a href="#sms-details-template" role="tab" data-toggle="tab">{{ 'mautic.n8ndispatch.smstemplate.tab.template.label'|trans }}</a></li>
        <li><a href="#sms-details-campaigns" role="tab" data-toggle="tab">{{ 'mautic.n8ndispatch.smstemplate.tab.campaigns.label'|trans }}</a></li>
    </ul>
    <div class="tab-content pa-md">
    <div class="tab-pane fade in active bdr-w-0" id="sms-details-template">
    <p>
        <strong>{{ 'mautic.core.language'|trans }}:</strong> {{ entity.language }}<br/>
        <strong>{{ 'mautic.core.name'|trans }}:</strong> {{ entity.name }}<br/>
        {% if entity.description %}
            <strong>{{ 'mautic.core.description'|trans }}:</strong> {{ entity.description|purify }}<br/>
        {% endif %}
        <strong>{{ 'mautic.core.form.available'|trans }}:</strong> {{ (entity.isPublished ? 'mautic.core.form.yes' : 'mautic.core.form.no')|trans }}
    </p>
    <p class="n8ndispatch-template-label"><strong>{{ 'mautic.n8ndispatch.template.details.text'|trans }}:</strong></p>
    <pre class="n8ndispatch-timeline-json n8ndispatch-callback-message">{{ entity.text }}</pre>
    {% include '@N8nDispatch/Template/_variables.html.twig' %}
    </div>
    <div class="tab-pane fade bdr-w-0" id="sms-details-campaigns">
        {% include '@N8nDispatch/Template/_campaigns.html.twig' with {'translationBase': 'mautic.n8ndispatch.smstemplate'} %}
    </div>
    </div>
    {% include '@N8nDispatch/Template/_modal_buttons.html.twig' with {'editUrl': canEdit ? path('mautic_n8ndispatch.smstemplate_action', {'objectAction': 'edit', 'objectId': entity.id}) : null} %}
</div>
