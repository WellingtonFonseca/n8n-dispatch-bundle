{#
  Timeline card shared by both the "Send via n8n (Email)" and "Send via
  n8n (SMS)" Campaign Actions, registered as each event type's
  'timelineTemplate' in CampaignSubscriber.php — replaces
  @MauticCampaign/SubscribedEvents/Timeline/index.html.twig just for
  those event types. The error-handling block below is copied from that
  core template (same condition, same 'errors' variable) since overriding
  the whole content template means Mautic core's own error rendering no
  longer runs for us; everything under the n8ndispatch block is ours.

  The pending/scheduled block (isScheduled/cancelled/dateSpan + the
  reschedule/save/cancel buttons) is copied from the same core template
  for the same reason: a pending row (no dispatch attempted yet, so
  item.metadata.n8ndispatch doesn't exist) used to render as a blank
  card here, while core's own 'Upcoming Events' tab already showed the
  real next-trigger time for it (item.triggerDate, kept up to date by
  CampaignBundle's own scheduler — already reflects any hour/day
  restriction on the event). Reusing core's block instead of computing
  anything ourselves keeps this in sync with whatever core does.

  One real bug fixed on top of the core copy: the 'cancelled' message
  (dateSpan embedded via a %date% placeholder, itself real HTML) is
  missing a |purify on core's own version, unlike the sibling
  'scheduled' message right above it — Twig's autoescaping then prints
  the <span ...> literally instead of rendering it. Added |purify here
  to match; core's own native card still has this bug.

  The 'Body' block below dumps the whole item.metadata.n8ndispatch bag
  minus its own outcome/meta keys, rather than a fixed list of field
  names — Email's and SMS's payload shapes differ (mautic_template_id vs.
  message, for one), so this stays correct for both without a
  channel-specific copy of this template.

  Variables
    - event (event.extra.log is the LeadEventLog row, as an array)
#}
{% set item = event.extra.log %}
{% set errors = false %}
{% if (item.metadata.errors is defined and item.metadata.errors is not empty) %}
    {% set errors = (item.metadata.errors is iterable) ? item.metadata.errors|join('<br />') : item.metadata.errors %}
{% elseif (item.metadata.failed is defined and item.metadata.failed is not empty) %}
    {% set errors = (item.metadata.reason is not empty) ? item.metadata.reason : 'mautic.campaign.event.failed.timeline' %}
    {% set errors = errors|trans %}
{% elseif (item.fail_reason is defined and item.fail_reason is not empty) %}
    {% set errors = item.fail_reason %}
{% endif %}

{#
  core's own 'cancelled' detection further below (the isScheduled block)
  assumes date_triggered stays NULL for a row that was scheduled, then
  cancelled, never actually dispatched — not true in this Mautic version:
  date_triggered gets set the moment the row is first created/held for
  scheduling, not only on real execution. That makes 'cancelled' compute
  false here in practice, so that whole block (and the 'cancelled by'
  span inside it) never renders again once is_scheduled flips back to 0
  on a later page load — only this top 'errors' paragraph survives a
  reload (core's own cancel action writes straight into metadata.errors).
  So the 'cancelled by' info is appended here too, not only in that
  other, session-live-only block.
#}
{% if errors and item.metadata.n8ndispatch_cancellation is defined and item.metadata.n8ndispatch_cancellation.cancelledByEmail is defined and item.metadata.n8ndispatch_cancellation.cancelledByEmail %}
    {% set cancelledAt = item.metadata.n8ndispatch_cancellation.cancelledAt is defined ? item.metadata.n8ndispatch_cancellation.cancelledAt : null %}
    {% set errors = errors ~ '<br/>' ~ ('mautic.n8ndispatch.timeline.cancelled_by'|trans({
        '%email%': item.metadata.n8ndispatch_cancellation.cancelledByEmail,
        '%date%': cancelledAt ? dateToFullConcat(cancelledAt, 'UTC') : '',
    })) %}
{% endif %}

{% set cancelled = item.isScheduled is empty and item.dateTriggered is empty %}
{% set dateSpan  = item.triggerDate is not empty ? '<span class="timeline-campaign-event-date-' ~ item.event_id ~ '" data-date="' ~ item.triggerDate.format('Y-m-d H:i:s') ~ '">' ~ dateToFullConcat(item.triggerDate) ~ '</span>' : '' %}

{% if (cancelled) %}
    {# Note is scheduled #}
    {% set item = item|merge({'isScheduled': true}) %}
{% endif %}

<div class="mt-10">
{% if (item.isScheduled) %}
    {#
      n8ndispatch-timeline-scheduled is our own inline-flex row, not core's
      .form-buttons (position: absolute, meant for FormBundle's field-editor
      rows — with no positioned ancestor nearby on the contact's History
      tab, it pinned the reschedule/cancel buttons to a distant corner
      instead of next to this text). The three <button> elements below
      still carry core's own required classes/ids (.btn, .btn-reschedule,
      #timeline-campaign-event-save-*) — Mautic's own campaign.js selects
      them by those exact hooks (disable-during-request, reveal-on-
      reschedule, etc.), so only their visual classes were swapped for
      our own (n8ndispatch-timeline-btn), never the functional ones.
    #}
    <p class="mt-0 mb-10 text-info n8ndispatch-timeline-scheduled" id="timeline-campaign-event-{{ item.event_id }}">
        <span id="timeline-campaign-event-text-{{ item.event_id }}"{{ cancelled ? ' class="text-warning"' : '' }}>
            <i class="ri-time-line"></i>
            <span class="timeline-campaign-event-scheduled-{{ item.event_id }}{{cancelled ? ' hide' : '' }}">
                {{ 'mautic.core.timeline.event.scheduled.time'|trans({'%date%' : dateSpan, '%event%' : event.eventLabel})|purify }}
                {#
                  Unlike the cancellation case, this row stays
                  is_scheduled=1 after a reschedule — item.isScheduled
                  keeps reflecting the real column on every later page
                  load, so metadata.n8ndispatch_reschedule (written by
                  Assets/js/campaign-timeline-scheduled.js's global
                  ajaxSuccess listener, action=plugin:N8nDispatch:
                  recordScheduleReschedule) can be read directly here —
                  no equivalent to the cancellation block's 'errors'
                  fallback is needed for this one.
                #}
                <span class="n8ndispatch-timeline-rescheduled-by-{{ item.event_id }}">
                    {%- if item.metadata.n8ndispatch_reschedule is defined and item.metadata.n8ndispatch_reschedule.rescheduledByEmail is defined and item.metadata.n8ndispatch_reschedule.rescheduledByEmail -%}
                        {% set rescheduledAt = item.metadata.n8ndispatch_reschedule.rescheduledAt is defined ? item.metadata.n8ndispatch_reschedule.rescheduledAt : null %}
                        <br/>{{ 'mautic.n8ndispatch.timeline.rescheduled_by'|trans({
                            '%email%': item.metadata.n8ndispatch_reschedule.rescheduledByEmail,
                            '%date%': rescheduledAt ? dateToFullConcat(rescheduledAt, 'UTC') : '',
                        })|purify }}
                    {%- endif -%}
                </span>
            </span>
            {#
              metadata.n8ndispatch_cancellation is set by our own separate
              ajax call (Assets/js/campaign-timeline-scheduled.js,
              action=plugin:N8nDispatch:recordScheduleCancellation) — core's
              own cancel endpoint has no concept of who clicked cancel. A
              distinct top-level metadata key on purpose, not nested under
              'n8ndispatch' — that one is reserved for an actual dispatch
              request/response payload (status/response/httpStatusCode,
              read by the 'n8n dispatch outcome' block further below);
              reusing it here made that block treat a cancelled-before-ever-
              dispatching row as if it had a dispatch outcome and crash
              reading n8n.status, which never exists on it.
              This can legitimately be absent (e.g. a row cancelled before
              this feature existed) — the base 'cancelled' sentence above
              still renders fine on its own either way. This <span> is
              empty on first render (metadata not written yet — cancelling
              happens client-side, after page load) and filled in live by
              the same JS's ajax success handler; only a later page load
              ever renders it from here server-side.
            #}
            <span class="timeline-campaign-event-cancelled-{{ item.event_id }}{{ cancelled is empty ? ' hide' : '' }}">
                {{ 'mautic.campaign.event.cancelled.time'|trans({'%date%' : dateSpan, '%event%' : event.eventLabel})|purify }}
                <span class="n8ndispatch-timeline-cancelled-by-{{ item.event_id }}">
                    {%- if item.metadata.n8ndispatch_cancellation is defined and item.metadata.n8ndispatch_cancellation.cancelledByEmail is defined and item.metadata.n8ndispatch_cancellation.cancelledByEmail -%}
                        {% set cancelledAt = item.metadata.n8ndispatch_cancellation.cancelledAt is defined ? item.metadata.n8ndispatch_cancellation.cancelledAt : null %}
                        <br/>{{ 'mautic.n8ndispatch.timeline.cancelled_by'|trans({
                            '%email%': item.metadata.n8ndispatch_cancellation.cancelledByEmail,
                            '%date%': cancelledAt ? dateToFullConcat(cancelledAt, 'UTC') : '',
                        })|purify }}
                    {%- endif -%}
                </span>
            </span>
        </span>
        {% if (lead and securityHasEntityAccess('lead:leads:editown', 'lead:leads:editother', lead.getPermissionUser())) %}
        {#
          Same button component core's own campaign builder canvas card
          uses for its icon-only edit/delete actions (Event/_generic.html.twig)
          — variant/icon_only/danger/size, rather than hand-written <button>
          markup. Functional hooks core's own campaign.js selects by
          (.btn-reschedule, the save button's id, onclick handlers) are
          passed through via 'attributes' so reschedule/cancel/save keep
          working exactly as before; only the visual classes now come
          from this component instead of .btn-ghost.

          Cancel additionally goes through core's own confirmation-modal
          helper (Mautic.showConfirmation, Assets/js/9.modals.js) instead
          of cancelling straight away. It's called directly from onclick
          rather than via the usual data-toggle="confirmation"
          auto-binding, since that only wires up <a> elements
          (Mautic.makeConfirmationsAlive's selector is
          "a[data-toggle='confirmation']" — CoreBundle/Assets/js/
          1a.content.js:375) and this needs to stay a real <button> for
          the disabled state to work. n8ndispatchConfirmCancelSchedule
          (Assets/js/campaign-timeline-scheduled.js) reads the event/
          contact ids back off this same element via data-event-id/
          data-contact-id and does the actual cancelScheduledCampaignEvent
          call once the user confirms.
        #}
        <span class="n8ndispatch-timeline-actions" role="group" aria-label="{{ 'mautic.n8ndispatch.timeline.actions.label'|trans }}">
            {% include '@MauticCore/Helper/button.html.twig' with {
                buttons: [
                    {
                        label: 'mautic.campaign.event.save',
                        variant: 'primary',
                        size: 'xs',
                        icon_only: true,
                        icon: 'ri-save-line',
                        onclick: 'Mautic.saveScheduledCampaignEvent(' ~ item.event_id ~ ', ' ~ lead.getId() ~ ')',
                        attributes: {
                            id: 'timeline-campaign-event-save-' ~ item.event_id,
                            onmousedown: 'return false;',
                            style: 'display:none',
                        },
                    },
                    {
                        label: 'mautic.campaign.event.reschedule',
                        variant: 'primary',
                        size: 'xs',
                        icon_only: true,
                        icon: 'ri-time-line',
                        onclick: 'Mautic.updateScheduledCampaignEvent(' ~ item.event_id ~ ', ' ~ lead.getId() ~ ')',
                        attributes: {
                            id: 'timeline-campaign-event-reschedule-' ~ item.event_id,
                            class: 'btn-reschedule',
                        },
                    },
                    {
                        label: 'mautic.campaign.event.cancel',
                        variant: 'primary',
                        danger: true,
                        size: 'xs',
                        icon_only: true,
                        icon: 'ri-close-line',
                        onclick: 'Mautic.showConfirmation(this)',
                        attributes: (cancelled ? { disabled: 'disabled' } : {})|merge({
                            id: 'timeline-campaign-event-cancel-' ~ item.event_id,
                            'data-event-id': item.event_id,
                            'data-contact-id': lead.getId(),
                            'data-message': 'mautic.n8ndispatch.timeline.cancel_schedule.message'|trans,
                            'data-confirm-text': 'mautic.n8ndispatch.timeline.cancel_schedule.confirm_btn'|trans,
                            'data-cancel-text': 'mautic.n8ndispatch.timeline.cancel_schedule.keep_btn'|trans,
                            'data-confirm-callback': 'n8ndispatchConfirmCancelSchedule',
                            'data-confirm-btn-class': 'btn btn-danger',
                        }),
                    },
                ]
            } %}
        </span>
        {% endif %}
    </p>
{% endif %}

{% if (errors) %}
    {% if (item.isScheduled) %}
    <hr />
    {% endif %}
    <p class="text-danger mt-0 mb-10"><i class="ri-alert-line"></i> {{ 'mautic.campaign.event.last_error'|trans }}:<br/>{{ errors|purify }}</p>
{% endif %}

{% set n8n = item.metadata.n8ndispatch is defined ? item.metadata.n8ndispatch : null %}
{% if n8n %}
    {% set statusIcon = {
        'test':       'ri-bug-line',
        'production': 'ri-play-fill',
        'paused':     'ri-pause-fill',
    }[n8n.status]|default('ri-bug-line') %}
    <div class="n8ndispatch-timeline">
        <div class="n8ndispatch-timeline-header">
            <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ n8n.status }}">
                <i class="{{ statusIcon }}"></i>
                {{ ('mautic.n8ndispatch.campaign.event.status.' ~ n8n.status)|trans }}
            </span>

            {% if n8n.httpStatusCode is defined %}
                {% if n8n.httpStatusCode < 300 %}
                <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--success">
                    <i class="ri-check-line"></i>
                    {{ 'mautic.n8ndispatch.timeline.status.success'|trans }}
                </span>
                {% else %}
                <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--failed">
                    <i class="ri-close-line"></i>
                    {{ 'mautic.n8ndispatch.timeline.status.failed'|trans }}
                </span>
                {% endif %}
            {% endif %}
        </div>

        {% set jsonOptions = constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') %}
        {% set metaKeys = ['response', 'httpStatusCode', 'templateCopyHash'] %}
        {% set requestBody = n8n|filter((value, key) => key not in metaKeys) %}
        <p class="n8ndispatch-timeline-label">{{ 'mautic.n8ndispatch.timeline.body'|trans }}:</p>
        <pre class="n8ndispatch-timeline-json">{{ requestBody|json_encode(jsonOptions) }}</pre>

        {% if n8n.response is defined %}
        <p class="n8ndispatch-timeline-label">{{ 'mautic.n8ndispatch.timeline.response'|trans }}:</p>
        <pre class="n8ndispatch-timeline-json">{{ n8n.response is iterable ? n8n.response|json_encode(jsonOptions) : n8n.response }}</pre>
        {% endif %}

        {#
          Callback: the outcome n8n reported later, when Mautic asked it how
          this dispatch ended up (Service/StatusPoller.php, run by the
          n8ndispatch:status:poll command). One row per tracked id — Email
          and SMS have one, HSM has two (Mirror and Meta), each with its
          own outcome. The badge is the current outcome; an id never
          answered stays 'pending'. 'history' only has an entry when the
          outcome actually changed, so an id that went error -> success
          shows both. Dates are stored in UTC and printed by n8ndispatch_date()
          in the system language (Twig/StatusExtension.php).
        #}
        {% set callbacks = n8ndispatch_status(item.metadata) %}
        {% if callbacks %}
        {% for callback in callbacks %}
            {% set badgeClass = {'success': 'success', 'error': 'failed', 'pending': 'pending'}[callback.outcome] %}
            {% set badgeIcon  = {'success': 'ri-check-line', 'error': 'ri-close-line', 'pending': 'ri-time-line'}[callback.outcome] %}
            {# Email/SMS: 'Callback'. HSM: one block per id, 'Callback Mirror' and 'Callback Meta' — no plain 'Callback' title. #}
            <p class="n8ndispatch-timeline-label">{{ (callback.refType == 'logSendHsmId' or callback.refType == 'logSendHsmUuid' ? 'mautic.n8ndispatch.timeline.callback.ref.' ~ callback.refType : 'mautic.n8ndispatch.timeline.callback')|trans }}:</p>
            <div class="n8ndispatch-callback">
                <div class="n8ndispatch-callback-checked text-muted">
                    {%- if callback.lastCheckedAt -%}
                        {{ 'mautic.n8ndispatch.timeline.callback.checked'|trans({'%date%': n8ndispatch_date(callback.lastCheckedAt)}) }}
                    {%- else -%}
                        {{ 'mautic.n8ndispatch.timeline.callback.never_checked'|trans }}
                    {%- endif -%}
                </div>
                <div class="n8ndispatch-callback-row">
                    <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ badgeClass }}">
                        <i class="{{ badgeIcon }}"></i>
                        {{ ('mautic.n8ndispatch.timeline.callback.outcome.' ~ callback.outcome)|trans }}
                    </span>
                </div>
                {# Whenever n8n sent a message, whatever the outcome: the label sits inside the block, above the text (the <pre> keeps the line break). #}
                {% if callback.message %}
                <pre class="n8ndispatch-timeline-json n8ndispatch-callback-message">{{ 'mautic.n8ndispatch.timeline.callback.message'|trans }}:
{{ callback.message }}</pre>
                {% endif %}
                {% if callback.history|length > 0 %}
                <details class="n8ndispatch-callback-history">
                    <summary>{{ 'mautic.n8ndispatch.timeline.callback.history'|trans({'%count%': callback.history|length}) }}</summary>
                    <ul>
                    {% for entry in callback.history|reverse %}
                        <li>
                            {{ ('mautic.n8ndispatch.timeline.callback.outcome.' ~ entry.outcome)|trans }}
                            · {{ n8ndispatch_date(entry.receivedAt) }}
                            {%- if entry.message %} — {{ entry.message }}{% endif %}
                        </li>
                    {% endfor %}
                    </ul>
                </details>
                {% endif %}
            </div>
        {% endfor %}
        {% endif %}
    </div>
{% endif %}
</div>
