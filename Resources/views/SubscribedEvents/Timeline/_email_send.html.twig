{#
  Timeline card shared by both the "Send via n8n (Email)" and "Send via
  n8n (SMS)" Campaign Actions, registered as each event type's
  'timelineTemplate' in CampaignSubscriber.php — replaces
  @MauticCampaign/SubscribedEvents/Timeline/index.html.twig just for
  those event types. The error-handling block below is copied from that
  core template (same condition, same 'errors' variable) since overriding
  the whole content template means Mautic core's own error rendering no
  longer runs for us; everything under the n8ndispatch block is ours.

  The pending/scheduled block (isScheduled/cancelled/dateSpan + the
  reschedule/save/cancel buttons) is copied from the same core template
  for the same reason: a pending row (no dispatch attempted yet, so
  item.metadata.n8ndispatch doesn't exist) used to render as a blank
  card here, while core's own 'Upcoming Events' tab already showed the
  real next-trigger time for it (item.triggerDate, kept up to date by
  CampaignBundle's own scheduler — already reflects any hour/day
  restriction on the event). Reusing core's block instead of computing
  anything ourselves keeps this in sync with whatever core does.

  The 'Body' block below dumps the whole item.metadata.n8ndispatch bag
  minus its own outcome/meta keys, rather than a fixed list of field
  names — Email's and SMS's payload shapes differ (mautic_template_id vs.
  message, for one), so this stays correct for both without a
  channel-specific copy of this template.

  Variables
    - event (event.extra.log is the LeadEventLog row, as an array)
#}
{% set item = event.extra.log %}
{% set errors = false %}
{% if (item.metadata.errors is defined and item.metadata.errors is not empty) %}
    {% set errors = (item.metadata.errors is iterable) ? item.metadata.errors|join('<br />') : item.metadata.errors %}
{% elseif (item.metadata.failed is defined and item.metadata.failed is not empty) %}
    {% set errors = (item.metadata.reason is not empty) ? item.metadata.reason : 'mautic.campaign.event.failed.timeline' %}
    {% set errors = errors|trans %}
{% elseif (item.fail_reason is defined and item.fail_reason is not empty) %}
    {% set errors = item.fail_reason %}
{% endif %}

{% set cancelled = item.isScheduled is empty and item.dateTriggered is empty %}
{% set dateSpan  = item.triggerDate is not empty ? '<span class="timeline-campaign-event-date-' ~ item.event_id ~ '" data-date="' ~ item.triggerDate.format('Y-m-d H:i:s') ~ '">' ~ dateToFullConcat(item.triggerDate) ~ '</span>' : '' %}

{% if (cancelled) %}
    {# Note is scheduled #}
    {% set item = item|merge({'isScheduled': true}) %}
{% endif %}

<div class="mt-10">
{% if (item.isScheduled) %}
    <p class="mt-0 mb-10 text-info" id="timeline-campaign-event-{{ item.event_id }}">
        <span id="timeline-campaign-event-text-{{ item.event_id }}"{{ cancelled ? ' class="text-warning"' : '' }}>
            <i class="ri-time-line"></i>
            <span class="timeline-campaign-event-scheduled-{{ item.event_id }}{{cancelled ? ' hide' : '' }}">
                {{ 'mautic.core.timeline.event.scheduled.time'|trans({'%date%' : dateSpan, '%event%' : event.eventLabel})|purify }}
            </span>
            <span class="timeline-campaign-event-cancelled-{{ item.event_id }}{{ cancelled is empty ? ' hide' : '' }}">
                {{ 'mautic.campaign.event.cancelled.time'|trans({'%date%' : dateSpan, '%event%' : event.eventLabel}) }}
            </span>
        </span>
        {% if (lead and securityHasEntityAccess('lead:leads:editown', 'lead:leads:editother', lead.getPermissionUser())) %}
        <span class="form-buttons btn-group btn-group-xs mb-3" role="group" aria-label="Field options">
            <button type="button" id="timeline-campaign-event-save-{{ item.event_id }}" class="btn btn-ghost btn-nospin" onmousedown="return false;" onclick="Mautic.saveScheduledCampaignEvent({{ item.event_id }}, {{ lead.getId() }})" data-toggle="tooltip" title="{{ 'mautic.campaign.event.save'|trans }}" style="display:none">
                <i class="ri-save-line text-primary"></i>
            </button>
            <button type="button" class="btn btn-ghost btn-nospin btn-reschedule" onclick="Mautic.updateScheduledCampaignEvent({{ item.event_id }}, {{ lead.getId() }})" data-toggle="tooltip" title="{{ 'mautic.campaign.event.reschedule'|trans }}">
                <i class="ri-time-line text-primary"></i>
            </button>
            <button type="button" class="btn btn-ghost btn-nospin"{{ cancelled ? ' disabled' : '' }} onclick="Mautic.cancelScheduledCampaignEvent({{ item.event_id }}, {{ lead.getId() }})" data-toggle="tooltip" title="{{ 'mautic.campaign.event.cancel'|trans }}">
                <i class="ri-close-line text-danger"></i>
            </button>
        </span>
        {% endif %}
    </p>
{% endif %}

{% if (errors) %}
    {% if (item.isScheduled) %}
    <hr />
    {% endif %}
    <p class="text-danger mt-0 mb-10"><i class="ri-alert-line"></i> {{ 'mautic.campaign.event.last_error'|trans }}:<br/>{{ errors|purify }}</p>
{% endif %}

{% set n8n = item.metadata.n8ndispatch is defined ? item.metadata.n8ndispatch : null %}
{% if n8n %}
    {% set statusIcon = {
        'test':       'ri-bug-line',
        'production': 'ri-play-fill',
        'paused':     'ri-pause-fill',
    }[n8n.status]|default('ri-bug-line') %}
    <div class="n8ndispatch-timeline">
        <div class="n8ndispatch-timeline-header">
            <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ n8n.status }}">
                <i class="{{ statusIcon }}"></i>
                {{ ('mautic.n8ndispatch.campaign.event.status.' ~ n8n.status)|trans }}
            </span>

            {% if n8n.httpStatusCode is defined %}
                {% if n8n.httpStatusCode < 300 %}
                <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--success">
                    <i class="ri-check-line"></i>
                    {{ 'mautic.n8ndispatch.timeline.status.success'|trans }}
                </span>
                {% else %}
                <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--failed">
                    <i class="ri-close-line"></i>
                    {{ 'mautic.n8ndispatch.timeline.status.failed'|trans }}
                </span>
                {% endif %}
            {% endif %}
        </div>

        {% set jsonOptions = constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') %}
        {% set metaKeys = ['response', 'httpStatusCode', 'templateCopyHash'] %}
        {% set requestBody = n8n|filter((value, key) => key not in metaKeys) %}
        <p class="n8ndispatch-timeline-label">{{ 'mautic.n8ndispatch.timeline.body'|trans }}:</p>
        <pre class="n8ndispatch-timeline-json">{{ requestBody|json_encode(jsonOptions) }}</pre>

        {% if n8n.response is defined %}
        <p class="n8ndispatch-timeline-label">{{ 'mautic.n8ndispatch.timeline.response'|trans }}:</p>
        <pre class="n8ndispatch-timeline-json">{{ n8n.response is iterable ? n8n.response|json_encode(jsonOptions) : n8n.response }}</pre>
        {% endif %}
    </div>
{% endif %}
</div>
