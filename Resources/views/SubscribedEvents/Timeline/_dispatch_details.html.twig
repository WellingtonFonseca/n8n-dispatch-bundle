{#
  The dispatch part of the n8n Timeline card: last error, the Body/Response
  JSONs, the callback badges with their messages and the callback history.
  Shared by the contact's History card (_email_send.html.twig, after its
  own schedule block) and the Dispatches screen's details modal
  (Dispatch/details.html.twig), so both always show the same thing.

  Variables
    - item   the campaign log as an array (metadata, isScheduled, ...)
    - errors the last error text, or false; worked out here from the log
             when the caller does not pass it (the details modal)
#}
{% if errors is not defined %}
    {% set errors = false %}
    {% if (item.metadata.errors is defined and item.metadata.errors is not empty) %}
        {% set errors = (item.metadata.errors is iterable) ? item.metadata.errors|join('<br />') : item.metadata.errors %}
    {% elseif (item.metadata.failed is defined and item.metadata.failed is not empty) %}
        {% set errors = ((item.metadata.reason is not empty) ? item.metadata.reason : 'mautic.campaign.event.failed.timeline')|trans %}
    {% endif %}
{% endif %}
{% if (errors) %}
    {% if (item.isScheduled) %}
    <hr />
    {% endif %}
    <p class="text-danger mt-0 mb-10"><i class="ri-alert-line"></i> {{ 'mautic.campaign.event.last_error'|trans }}:<br/>{{ errors|purify }}</p>
{% endif %}

{% if item.metadata.n8ndispatch_resend is defined and item.metadata.n8ndispatch_resend %}
    <p class="text-muted mt-0 mb-10"><i class="ri-send-plane-line"></i> {{ item.metadata.n8ndispatch_resend|nl2br }}</p>
{% endif %}

{% set n8n = item.metadata.n8ndispatch is defined ? item.metadata.n8ndispatch : null %}
{% if n8n %}
    {% set statusIcon = {
        'test':       'ri-bug-line',
        'production': 'ri-play-fill',
        'paused':     'ri-pause-fill',
    }[n8n.status]|default('ri-bug-line') %}
    <div class="n8ndispatch-timeline">
        <div class="n8ndispatch-timeline-header">
            <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ n8n.status }}">
                <i class="{{ statusIcon }}"></i>
                {{ ('mautic.n8ndispatch.campaign.event.status.' ~ n8n.status)|trans }}
            </span>

            {% if n8n.httpStatusCode is defined %}
                {% if n8n.httpStatusCode >= 200 and n8n.httpStatusCode < 300 %}
                <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--success">
                    <i class="ri-check-line"></i>
                    {{ 'mautic.n8ndispatch.timeline.status.success'|trans }}
                </span>
                {% else %}
                <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--failed">
                    <i class="ri-close-line"></i>
                    {{ 'mautic.n8ndispatch.timeline.status.failed'|trans }}
                </span>
                {% endif %}
            {% endif %}
        </div>

        {% set jsonOptions = constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') %}
        {% set metaKeys = ['response', 'httpStatusCode', 'templateCopyHash'] %}
        {% set requestBody = n8n|filter((value, key) => key not in metaKeys) %}
        <p class="n8ndispatch-timeline-label">{{ 'mautic.n8ndispatch.timeline.body'|trans }}:</p>
        <pre class="n8ndispatch-timeline-json">{{ requestBody|json_encode(jsonOptions) }}</pre>

        {% if n8n.response is defined %}
        <p class="n8ndispatch-timeline-label">{{ 'mautic.n8ndispatch.timeline.response'|trans }}:</p>
        <pre class="n8ndispatch-timeline-json">{{ n8n.response is iterable ? n8n.response|json_encode(jsonOptions) : n8n.response }}</pre>
        {% endif %}

        {#
          Callback: the outcome n8n reported later, when Mautic asked it how
          this dispatch ended up (Service/StatusPoller.php, run by the
          n8ndispatch:status:poll command). One row per tracked id — Email
          and SMS have one, HSM has two (Mirror and Meta), each with its
          own outcome. The badge is the current outcome; an id never
          answered stays 'pending'. 'history' (shown once, at the end of the card) only has an entry when the
          outcome actually changed, so an id that went error -> success
          shows both. Dates are stored in UTC and printed by n8ndispatch_date()
          in the system language (Twig/StatusExtension.php).
        #}
        {% set callbacks = n8ndispatch_status(item.metadata) %}
        {% if callbacks %}
        {% for callback in callbacks %}
            {% set badgeClass = {'success': 'success', 'error': 'failed', 'pending': 'pending'}[callback.outcome] %}
            {% set badgeIcon  = {'success': 'ri-check-line', 'error': 'ri-close-line', 'pending': 'ri-time-line'}[callback.outcome] %}
            {# Email/SMS: 'Callback'. HSM: one block per id, 'Callback' (the Mirror id) and 'Callback Meta'. #}
            <p class="n8ndispatch-timeline-label n8ndispatch-callback-title">{{ (callback.refType == 'logSendHsmId' or callback.refType == 'logSendHsmUuid' ? 'mautic.n8ndispatch.timeline.callback.ref.' ~ callback.refType : 'mautic.n8ndispatch.timeline.callback')|trans }}:</p>
            <div class="n8ndispatch-callback">
                <div class="n8ndispatch-callback-checked text-muted">
                    {%- if callback.lastCheckedAt -%}
                        {{ 'mautic.n8ndispatch.timeline.callback.checked'|trans({'%date%': n8ndispatch_date(callback.lastCheckedAt)}) }}
                    {%- else -%}
                        {{ 'mautic.n8ndispatch.timeline.callback.never_checked'|trans }}
                    {%- endif -%}
                </div>
                <div class="n8ndispatch-callback-row">
                    <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ badgeClass }}">
                        <i class="{{ badgeIcon }}"></i>
                        {{ ('mautic.n8ndispatch.timeline.callback.outcome.' ~ callback.outcome)|trans }}
                    </span>
                </div>
                {# Whenever n8n sent a message, whatever the outcome: the label sits inside the block, above the text (the <pre> keeps the line break). #}
                {% if callback.message %}
                <pre class="n8ndispatch-timeline-json n8ndispatch-callback-message">{{ 'mautic.n8ndispatch.timeline.callback.message'|trans }}:
{{ callback.message }}</pre>
                {% endif %}
            </div>
        {% endfor %}

        {% endif %}

        {#
          History, once, at the very end of the card: a title that opens, on
          click, ONE table with everything that happened to this dispatch,
          newest first — each attempt to send to n8n ('Disparo': accepted or
          refused, with n8n's message) and each change of outcome n8n reported
          afterwards ('Callback'; HSM: 'Callback' for the Mirror's id and
          'Callback Meta' for Meta's). It is tied to the campaign log, so a
          resend adds rows instead of replacing them. item.log_id comes from
          core's Timeline row; the details modal passes it too.
        #}
        {% set historyEntries = item.log_id is defined and item.log_id ? n8ndispatch_history(item.log_id) : [] %}
        {% if historyEntries %}
        <details class="n8ndispatch-callback-history">
            <summary class="n8ndispatch-timeline-label n8ndispatch-callback-title">{{ 'mautic.n8ndispatch.timeline.callback.history'|trans }}:</summary>
            <table class="n8ndispatch-callback-history-table">
                <thead>
                    <tr>
                        <th>{{ 'mautic.n8ndispatch.timeline.history.type'|trans }}</th>
                        <th>{{ 'mautic.n8ndispatch.timeline.callback.history.status'|trans }}</th>
                        <th>{{ 'mautic.n8ndispatch.timeline.history.id'|trans }}</th>
                        <th>{{ 'mautic.n8ndispatch.timeline.callback.history.date'|trans }}</th>
                        <th>{{ 'mautic.n8ndispatch.timeline.callback.history.message'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for entry in historyEntries %}
                    {% set isDispatch = entry.kind == 'dispatch' %}
                    {% set badgeKey   = {'success': 'success', 'failed': 'failed', 'error': 'failed', 'pending': 'pending'}[entry.outcome]|default('pending') %}
                    <tr>
                        <td>
                            {%- if isDispatch -%}
                                {{ 'mautic.n8ndispatch.timeline.history.type.dispatch'|trans }}
                            {%- else -%}
                                {{ (entry.refType == 'logSendHsmId' or entry.refType == 'logSendHsmUuid' ? 'mautic.n8ndispatch.timeline.callback.ref.' ~ entry.refType : 'mautic.n8ndispatch.timeline.callback')|trans }}
                            {%- endif -%}
                        </td>
                        <td>
                            {#
                              Dispatch: 'Produção' with the result under it (Sucesso / Falhou), or
                              just 'Teste' / 'Pausado' when nothing was sent. Callback: its outcome.
                            #}
                            {% if isDispatch and entry.outcome in ['test', 'paused'] %}
                            <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ entry.outcome }}">
                                <i class="{{ {'test': 'ri-bug-line', 'paused': 'ri-pause-fill'}[entry.outcome] }}"></i>
                                {{ ('mautic.n8ndispatch.campaign.event.status.' ~ entry.outcome)|trans }}
                            </span>
                            {% else %}
                            {% if isDispatch %}
                            <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--production" style="margin-bottom: 4px;">
                                <i class="ri-play-fill"></i>
                                {{ 'mautic.n8ndispatch.campaign.event.status.production'|trans }}
                            </span><br/>
                            {% endif %}
                            <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ badgeKey }}">
                                <i class="{{ {'success': 'ri-check-line', 'failed': 'ri-close-line', 'pending': 'ri-time-line'}[badgeKey] }}"></i>
                                {{ (isDispatch ? 'mautic.n8ndispatch.timeline.status.' ~ (entry.outcome == 'success' ? 'success' : 'failed') : 'mautic.n8ndispatch.timeline.callback.outcome.' ~ entry.outcome)|trans }}
                            </span>
                            {% endif %}
                        </td>
                        <td>{{ entry.refValue }}</td>
                        <td>{{ n8ndispatch_date(entry.receivedAt) }}</td>
                        {# Same block as the JSONs and the message above, with no label: the column already says what it is. A refused resend's message holds the note (who and when), a blank line, then n8n's answer. #}
                        <td>{% if entry.message %}<pre class="n8ndispatch-timeline-json n8ndispatch-callback-message">{{ entry.message }}</pre>{% endif %}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </details>
        {% endif %}
    </div>
{% endif %}
