<div class="tab-pane fade bdr-w-0" id="n8ndispatch-email-tab-container">
    <div class="row">
        <div class="col-xs-12">
            <p class="text-muted">{{ 'mautic.n8ndispatch.email.tab.variables.help'|trans }}</p>
        </div>
    </div>
    <div class="row">
        <div id="n8ndispatch-variables-container"
             class="col-xs-12"
             data-email-id="{{ emailId }}"
             data-alert-text="{{ 'mautic.n8ndispatch.email.alert.text'|trans }}"
             data-alert-tab="{{ 'mautic.n8ndispatch.email.tab.label'|trans }}"
             data-onload-callback="n8nDispatchInitEmailTabVariables">
            <p class="text-muted">{{ 'mautic.n8ndispatch.email.tab.variables.none'|trans }}</p>
        </div>
    </div>
    <input type="hidden" class="n8ndispatch-variables-json" value="{{ savedVariablesJson }}">
</div>
