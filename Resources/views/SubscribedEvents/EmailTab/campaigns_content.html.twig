{#
  Same status-badge markup/CSS as SmsTemplate/form.html.twig's own
  "Campaigns using this template" table (.n8ndispatch-timeline-badge,
  already loaded globally by AssetInjectionSubscriber.php) and the
  contact Timeline card — kept visually consistent across all three.
#}
{% set statusIcons = {
    'test':       'ri-bug-line',
    'production': 'ri-play-fill',
    'paused':     'ri-pause-fill',
} %}
<div class="tab-pane fade bdr-w-0" id="n8ndispatch-email-campaigns-tab-container">
    <div class="row">
        <div class="col-xs-12">
            {% if campaignUsages is not empty %}
                <table class="table table-condensed">
                    <thead>
                    <tr>
                        <th>{{ 'mautic.n8ndispatch.email.tab.campaigns.campaign'|trans }}</th>
                        <th>{{ 'mautic.n8ndispatch.email.tab.campaigns.step'|trans }}</th>
                        <th>{{ 'mautic.n8ndispatch.campaign.event.status'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for usage in campaignUsages %}
                        <tr>
                            <td>
                                <a href="{{ path('mautic_campaign_action', {'objectAction': 'view', 'objectId': usage.campaignId}) }}" data-toggle="ajax">{{ usage.campaignName }}</a>
                                {% if not usage.campaignPublished %}
                                    <span class="label label-default">{{ 'mautic.n8ndispatch.email.tab.campaigns.unpublished'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>{{ usage.eventName }}</td>
                            <td>
                                {% set status = statusIcons[usage.status] is defined ? usage.status : 'test' %}
                                <span class="n8ndispatch-timeline-badge n8ndispatch-timeline-badge--{{ status }}">
                                    <i class="{{ statusIcons[status] }}"></i>
                                    {{ ('mautic.n8ndispatch.campaign.event.status.' ~ status)|trans }}
                                </span>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="text-muted">{{ 'mautic.n8ndispatch.email.tab.campaigns.none'|trans }}</p>
            {% endif %}
        </div>
    </div>
</div>
